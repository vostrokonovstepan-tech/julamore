# Скопируйте этот файл в server/.env и впишите свои значения.
# Файл .env не попадает в git и в браузер.

# --- Заявки на почту (российский сервис, ничего не уходит за границу) ---
# Для bk.ru / mail.ru / inbox.ru / list.ru — smtp.mail.ru, порт 465.
# Для Яндекса — smtp.yandex.ru, порт 465.
MAIL_HOST=smtp.mail.ru
MAIL_PORT=465
# Полный адрес ящика и ПАРОЛЬ ДЛЯ ВНЕШНЕГО ПРИЛОЖЕНИЯ (не обычный пароль!).
# Mail.ru: Настройки → Безопасность → Пароли для внешних приложений.
MAIL_USER=juliya_work@bk.ru
MAIL_PASS=
# Куда слать заявки (можно несколько адресов через запятую)
MAIL_TO=juliya_work@bk.ru

# --- Заявки в Telegram (необязательно; пусто — канал выключен) ---
# Токен бота из @BotFather
TELEGRAM_TOKEN=
# Номера чатов, куда приходят заявки — можно несколько через запятую (узнать: написать боту,
# открыть https://api.telegram.org/bot<ТОКЕН>/getUpdates и взять "chat":{"id": ...}).
# Каждый получатель должен хотя бы раз написать боту, иначе Telegram не пропустит сообщение.
TELEGRAM_CHAT_ID=
# В бот уходит только сигнал «новая заявка» без имён и телефонов — персональные
# данные остаются на сервере. TELEGRAM_FULL_TEXT=1 шлёт полный текст заявки,
# но тогда это трансграничная передача данных со всеми обязанностями оператора.
# TELEGRAM_FULL_TEXT=0
# Адрес сайта — подставляется ссылкой на список заявок в уведомлении
# SITE_URL=https://julamore.ru

# --- Страница со списком заявок (/leads.html) ---
# Пароль для входа. Пусто — страница выключена.
ADMIN_PASSWORD=

# На VPS оставьте как есть: сервер слушает только локально, сайт отдаёт nginx
PORT=3001
HOST=127.0.0.1
SERVE_STATIC=0

# Куда складывать копии заявок (по умолчанию server/leads)
# LEADS_DIR=/var/www/julamore/server/leads

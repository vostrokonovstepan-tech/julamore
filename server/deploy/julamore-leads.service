# /etc/systemd/system/julamore-leads.service
[Unit]
Description=Julamore lead form (Telegram)
After=network.target

[Service]
WorkingDirectory=/var/www/julamore/server
ExecStart=/usr/bin/node /var/www/julamore/server/server.js
Restart=always
User=www-data
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target

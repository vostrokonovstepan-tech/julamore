# /etc/systemd/system/julamore-leads.service
[Unit]
Description=Julamore lead form
After=network.target

[Service]
WorkingDirectory=/var/www/julamore/server
ExecStart=/usr/bin/node /var/www/julamore/server/server.js
Restart=always
RestartSec=3
User=www-data
Environment=NODE_ENV=production

# Ограничения: процессу доступен только свой каталог с заявками,
# он не может получить новые права и не видит домашние каталоги.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/www/julamore/server/leads
MemoryMax=300M

[Install]
WantedBy=multi-user.target
